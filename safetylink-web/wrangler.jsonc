{
  "name": "safetylink-api",
  "main": "worker/index.ts",
  "compatibility_date": "2024-03-20",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "account_id": "${CLOUDFLARE_ACCOUNT_ID}",
  "routes": [
    {
      "pattern": "safetylink.online/*",
      "zone_id": "${CLOUDFLARE_ZONE_ID}"
    },
    {
      "pattern": "www.safetylink.online/*",
      "zone_id": "${CLOUDFLARE_ZONE_ID}"
    }
  ],

  "vars": {
    "JWT_SECRET": "safetylink-secret-change-in-production"
  }
}
