  "alert_chain": {
    "description": "6-layer reactive dispatch — fires from highest to lowest based on available connectivity",
    "layers": [
      {
        "layer": 1,
        "name": "Full Data Dispatch",
        "requires": "2KB internet data",
        "cost": "~R0.01",
        "flow": [
          "App POST → api.safetylink.online/api/panic",
          "Twilio SMS → 5 emergency contacts",
          "Twilio WhatsApp → 5 emergency contacts",
          "VAPI.ai AI voice call → primary contact",
          "Infobip SMS → fallback if Twilio fails",
          "Bland.ai AI call → secondary voice fallback",
          "Telegram Bot → command center notification",
          "Cloudinary → upload photo evidence",
          "Upstash → log alert to Redis + Search index"
        ]
      },
      {
        "layer": 2,
        "name": "Compressed Data Dispatch",
        "requires": "200 bytes data",
        "cost": "~R0.00",
        "payload": "uid,lat,lon,timestamp,trigger",
        "flow": [
          "App POST compressed packet → api.safetylink.online",
          "Server fires same alert chain as Layer 1"
        ]
      },
      {
        "layer": 3,
        "name": "Direct SMS",
        "requires": "R1 airtime, signal only",
        "cost": "~R0.50 per SMS",
        "flow": [
          "Android SmsManager API → direct SMS",
          "Message: PANIC [name] [lat,lon] [timestamp]",
          "Sends to all 5 stored emergency contacts"
        ]
      },
      {
        "layer": 4,
        "name": "Please Call Me (PCM)",
        "requires": "R0 — free on all SA networks",
        "cost": "R0",
        "flow": [
          "App fires Intent.ACTION_CALL → *140*[contact]#",
          "Contact receives free missed call from user",
          "Configured for top 3 emergency contacts",
          "Network: Vodacom, MTN, Cell C, Telkom all support"
        ]
      },
      {
        "layer": 5,
        "name": "USSD Dispatch",
        "requires": "R0 — no airtime, no data",
        "cost": "R0.35 per session (billed to operator)",
        "status": "Pending Africa's Talking approval",
        "flow": [
          "User dials *120*[SafetyLink_code]#",
          "Africa's Talking webhook POST → api.safetylink.online/ussd",
          "Server parses session, fires alert chain",
          "USSD menu: 1=Panic, 2=Update contacts, 3=Subscription"
        ]
      },
      {
        "layer": 6,
        "name": "Offline Queue + BLE Mesh",
        "requires": "Nothing — fully offline",
        "cost": "R0",
        "flow": [
          "Alert saved to Room DB local queue",
          "BLE broadcast to nearby SafetyLink devices",
          "WorkManager retries every 15min when connectivity restores",
          "Queue persists for 7 days"
        ]
      }
    ]
  },

