<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="#0a0f1e"
    android:padding="10dp">

    <!-- Header bar: App name + hardware connection status -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="8dp">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="🛡️ SAFETYLINK SENTINEL"
            android:textColor="#38bdf8"
            android:textSize="11sp"
            android:textStyle="bold"
            android:letterSpacing="0.05" />

        <TextView
            android:id="@+id/notif_ble_status"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="● iTAG ONLINE"
            android:textColor="#34d399"
            android:textSize="10sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Big Central SOS Trigger Button -->
    <Button
        android:id="@+id/notif_btn_sos"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:background="#dc2626"
        android:text="🚨 EMERGENCY SOS"
        android:textColor="#ffffff"
        android:textSize="13sp"
        android:textStyle="bold"
        android:letterSpacing="0.05"
        android:layout_marginBottom="8dp" />

    <!-- Action Bar 1: Watch Me + Sync + Check-in -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:weightSum="3"
        android:layout_marginBottom="6dp">

        <Button
            android:id="@+id/notif_btn_watch_me"
            android:layout_width="0dp"
            android:layout_height="36dp"
            android:layout_weight="1"
            android:background="#1e293b"
            android:text="⏱️ Watch Me"
            android:textColor="#e2e8f0"
            android:textSize="10sp"
            android:textStyle="bold"
            android:layout_marginEnd="4dp" />

        <Button
            android:id="@+id/notif_btn_sync"
            android:layout_width="0dp"
            android:layout_height="36dp"
            android:layout_weight="1"
            android:background="#1e293b"
            android:text="🔄 Sync"
            android:textColor="#e2e8f0"
            android:textSize="10sp"
            android:textStyle="bold"
            android:layout_marginEnd="4dp" />

        <Button
            android:id="@+id/notif_btn_checkin"
            android:layout_width="0dp"
            android:layout_height="36dp"
            android:layout_weight="1"
            android:background="#1e293b"
            android:text="✅ Check-In"
            android:textColor="#e2e8f0"
            android:textSize="10sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Action Bar 2: Sound Location + AI Lizzy -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:weightSum="2">

        <Button
            android:id="@+id/notif_btn_sound_loc"
            android:layout_width="0dp"
            android:layout_height="36dp"
            android:layout_weight="1"
            android:background="#1e293b"
            android:text="📍 Sound Device"
            android:textColor="#e2e8f0"
            android:textSize="10sp"
            android:textStyle="bold"
            android:layout_marginEnd="4dp" />

        <Button
            android:id="@+id/notif_btn_lizzy"
            android:layout_width="0dp"
            android:layout_height="36dp"
            android:layout_weight="1"
            android:background="#065f46"
            android:text="🤖 AI Lizzy"
            android:textColor="#a7f3d0"
            android:textSize="10sp"
            android:textStyle="bold" />
    </LinearLayout>

</LinearLayout>
