{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "SafetyLink Admin",
  "version": "1.0.0",
  "identifier": "com.safetylink.admin.exe",
  "build": {
    "beforeDevCommand": "",
    "beforeBuildCommand": "",
    "devUrl": "http://localhost:1420",
    "frontendDist": "../"
  },
  "app": {
    "windows": [
      {
        "title": "SafetyLink Security Organization Portal",
        "width": 1100,
        "height": 700,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ]
  }
}
