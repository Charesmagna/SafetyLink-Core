rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // For the Advanced Pilot, we are temporarily allowing read/write access 
    // to these collections from the client side since the primary auth 
    // is currently handled via Stytch/Custom logic rather than Firebase Auth.
    // In production, these must be locked down to request.auth.uid.
    match /users/{userId} {
      allow read, write: if true;
    }
    match /organizations/{orgId} {
      allow read, write: if true;
    }
    match /panicEvents/{eventId} {
      allow read, write: if true;
    }
    match /auditLogs/{logId} {
      allow read, write: if true;
    }
  }
}
