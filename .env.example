# SafetyLink Core — Environment Variable Template
# Copy to .env locally or set as Cloudflare Worker / Render secrets.
# NEVER commit real secrets or tokens to version control.

# Database & Encryption
DATABASE_URL=
NEON_DATA_API_URL=
DATA_ENCRYPTION_KEY=

# Auth & Internal API
JWT_SECRET=
INTERNAL_API_SECRET=
ADMIN_PASSWORD=

# Emergency Voice & AI (VAPI / Bland / Gemini)
VAPI_PRIVATE_KEY=
VITE_VAPI_PUBLIC_KEY=
VAPI_ASSISTANT_ID=
VAPI_PHONE_NUMBER_ID=
BLAND_API_KEY=
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Cellular SMS, Voice & USSD Providers
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
AT_API_KEY=
AT_USERNAME=SafetyLink
USSD_PROVIDER=africastalking
USSD_WEBHOOK_SECRET=
SMSGATE_USERNAME=
SMSGATE_PASSWORD=
SMSGATE_BASE_URL=
RESPONSE_CENTRE_NUMBER=
ALERTS_ENABLED=true

# FCM & Rain SIM Zero-Airtime PCM Gateway
FCM_SERVICE_ACCOUNT=
FIREBASE_PROJECT_ID=safetylink-99e56
FIREBASE_SERVICE_ACCOUNT_KEY=
PCM_WEBHOOK_TOKEN=
PCM_WEBHOOK_SECRET=
RAIN_GATEWAY_MSISDN=

# Live Consumer & Organization Billing (PayFast & Paystack)
PAYFAST_MERCHANT_ID=
PAYFAST_MERCHANT_KEY=
PAYFAST_PASSPHRASE=
PAYFAST_SANDBOX=false
PAYSTACK_SECRET_KEY=
VITE_PAYSTACK_PUBLIC_KEY=

# Storage & Media (Cloudflare R2 / Cloudinary / Optional DeepAI)
CLOUDFLARE_API_TOKEN=
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=media
R2_ENDPOINT=
CLOUDINARY_CLOUD=
CLOUDINARY_KEY=
CLOUDINARY_SECRET=
DEEPAI_API_KEY=

# Live Safety Feed & Geolocation
FREENEWSAPI_KEY=
BIGDATACLOUD_API_KEY=

# IoT Hardware Panic Webhook (NB-IoT / Hikvision AX PRO / 4G Watch)
IOT_WEBHOOK_SECRET=

# Realtime / Push / Rate Limiting
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
PUSHER_APP_ID=
PUSHER_APP_KEY=
PUSHER_APP_SECRET=
VITE_ONESIGNAL_APP_ID=
VITE_CF_ANALYTICS_TOKEN=

# Optional GitHub Automation
GITHUB_TOKEN=
GITHUB_PAT=
GH_TOKEN=
