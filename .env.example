# Copy to .env and fill in your own credentials.
# Do not put real keys in this file. It is committed.

# Database
DATABASE_URL=postgresql://USER:PASSWORD@HOST/neondb?sslmode=require
NEON_DATA_API_URL=https://HOST.apirest.region.aws.neon.tech/neondb/rest/v1
DATA_ENCRYPTION_KEY=replace-with-32-byte-key

# VAPI
VAPI_PRIVATE_KEY=
VITE_VAPI_PUBLIC_KEY=
VAPI_ASSISTANT_ID=
VAPI_PHONE_NUMBER_ID=

# Gemini
GEMINI_MODEL=gemini-1.5-flash

# USSD (Africa's Talking)
USSD_PROVIDER=africastalking
USSD_API_KEY=
USSD_WEBHOOK_SECRET=
AT_USERNAME=

# WhatsApp / Twilio
WHATSAPP_PROVIDER=twilio
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
TWILIO_SID=
TWILIO_NUMBER=

# Internal API & Settings
INTERNAL_API_SECRET=
RESPONSE_CENTRE_NUMBER=
ALERTS_ENABLED=true
TEST_DESTINATION_NUMBER=

# AWS / Cloudflare R2
AWS_ENDPOINT_URL_S3=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=auto
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=media
R2_ENDPOINT=
R2_PREFIX=Safetylink/
CLOUDFLARE_API_TOKEN=

# Cloudinary
CLOUDINARY_CLOUD=
CLOUDINARY_URL=

# Paystack
PAYSTACK_SECRET_KEY=
VITE_PAYSTACK_PUBLIC_KEY=

# Pusher
PUSHER_APP_ID=
PUSHER_APP_KEY=
PUSHER_APP_SECRET=

# Stytch
STYTCH_PROJECT_ID=
VITE_STYTCH_PUBLIC_TOKEN=
STYTCH_SECRET=

# OneSignal
VITE_ONESIGNAL_APP_ID=

# Upstash
UPSTASH_SEARCH_REST_URL=
UPSTASH_SEARCH_REST_TOKEN=
UPSTASH_BOX_API_KEY=

# Africa's Talking
AFRICASTALKING_API_KEY=
AFRICASTALKING_USERNAME=

# WorkOS SSO
WORKOS_API_KEY=
WORKOS_CLIENT_ID=

# Wireless Logic SMS Aggregation
WIRELESS_LOGIC_API_CLIENT=
WIRELESS_LOGIC_API_KEY=
WIRELESS_LOGIC_ENDPOINT=https://simpro4.wirelesslogic.com/api/sms

# APILayer CountryLayer
APILAYER_ACCESS_KEY=
