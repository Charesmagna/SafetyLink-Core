# Standalone Backend (Prisma / ownCloud)
PORT=4000
DATABASE_URL="file:./sqlite.db"
ENCRYPTION_KEY="replace_with_64_hex_chars_minimum_256_bits"

# ownCloud Admin Credentials (if auto-provisioning)
OC_URL="http://localhost:8080"
OC_ADMIN="admin"
OC_ADMIN_PASS="your_secure_admin_password"

# Frontend Environment Variables (Vite)
VITE_LIZZY_PROVIDER="webspeech"
VITE_KLEV_AI_ENDPOINT="https://your-klev-ai-api.com/v1"
VITE_MASTER_INTERCEPT_KEY="000000"
VITE_THINGSBOARD_TOKEN="your_thingsboard_token_here"

# Twilio (server-side only — never expose in frontend bundle)
TWILIO_ACCOUNT_SID="ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
TWILIO_AUTH_TOKEN="your_twilio_auth_token"
TWILIO_FROM_NUMBER="+27xxxxxxxxx"

# Supabase (frontend — safe to expose via VITE_ prefix)
VITE_SUPABASE_URL="https://your-project.supabase.co"
VITE_SUPABASE_ANON_KEY="your_supabase_anon_key"

# Certificate Pinning (comma-separated SHA-256 SPKI fingerprints)
VITE_CERT_PINS="sha256/AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA="

