{
  "name": "safetylink-core",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx server.ts",
    "build:backend": "mkdir -p dist && echo \"API is running\" > dist/index.html && esbuild server.ts --bundle --platform=node --format=cjs --packages=external --outfile=dist/server.cjs",
    "build": "vite build && esbuild server.ts --bundle --platform=node --format=cjs --packages=external --sourcemap --outfile=dist/server.cjs",
    "cap:sync": "npx cap sync android",
    "branding": "node branding/generate-branding.cjs",
    "preview": "npm run build && node dist/server.cjs",
    "lint": "tsc --noEmit",
    "verify": "npm run lint && npm run build"
  },
