{
  "name": "safetylink-core",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx server.ts",
    "build": "vite build && esbuild server.ts --bundle --platform=node --format=cjs --packages=external --sourcemap --outfile=dist/server.cjs",
    "cap:sync": "npx cap sync android",
    "branding": "node branding/generate-branding.cjs",
    "preview": "vite preview",
    "lint": "tsc --noEmit",
    "test": "tsx src/tests/run-tests.ts",
    "build:electron": "npm run build && electron-builder --win -c.extraMetadata.main=electron-main.cjs",
    "start:worker": "node server/dispatch-worker.js",
    "start": "node dist/server.cjs"
  },
  "dependencies": {
    "@capacitor-community/bluetooth-le": "^6.0.0",
    "@capacitor-mlkit/barcode-scanning": "^6.2.0",
    "@capacitor/android": "^6.0.0",
    "@capacitor/app": "^6.0.0",
    "@capacitor/core": "^6.0.0",
    "@capacitor/filesystem": "^6.0.4",
    "@capacitor/geolocation": "^6.0.0",
    "@capacitor/haptics": "^6.0.0",
    "@capacitor/local-notifications": "^6.0.0",
    "@capacitor/push-notifications": "^6.0.5",
    "@capacitor/share": "^6.0.4",
    "@capacitor/splash-screen": "^6.0.4",
    "@capawesome-team/capacitor-android-foreground-service": "^6.2.0",
    "@google/genai": "^2.12.0",
    "@react-oauth/google": "^0.13.5",
    "@supabase/supabase-js": "^2.111.0",
    "@types/pg": "^8.20.3",
    "axios": "^1.18.1",
    "bullmq": "^6.0.5",
    "capacitor-voice-recorder": "^1.1.1",
    "connectycube": "^6.3.0",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "firebase": "^12.16.0",
    "ioredis": "^6.0.0",
    "leaflet": "^1.9.4",
    "lucide-react": "^1.23.0",
    "motion": "^12.42.2",
    "pg": "^8.22.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-leaflet": "^4.2.1",
    "telnyx": "^7.12.0",
    "twilio": "^6.0.2",
    "zustand": "^4.5.4"
  },
  "devDependencies": {
    "@capacitor/assets": "^3.0.5",
    "@capacitor/cli": "^8.4.2",
    "@types/leaflet": "^1.9.12",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^6.0.5",
    "autoprefixer": "^10.5.4",
    "concurrently": "^10.0.3",
    "drizzle-kit": "^0.18.1",
    "electron": "^43.1.1",
    "electron-builder": "^25.1.8",
    "esbuild": "^0.28.1",
    "postcss": "^8.5.19",
    "sharp": "^0.35.3",
    "tailwindcss": "^3.4.19",
    "tsx": "^4.23.1",
    "typescript": "^5.9.3",
    "vite": "^8.2.0",
    "vite-plugin-pwa": "^1.3.0",
    "wait-on": "^9.0.10"
  },
  "main": "electron-main.cjs",
  "build": {
    "appId": "com.safetylink.console",
    "productName": "SafetyLink Response Console",
    "files": [
      "dist/**/*",
      "electron-main.cjs",
      "public/**/*"
    ],
    "directories": {
      "output": "electron-dist"
    },
    "win": {
      "target": [
        "nsis"
      ]
    }
  },
  "overrides": {
    "@capgo/capacitor-audio-recorder": {
      "@capacitor/core": "$@capacitor/core"
    }
  }
}