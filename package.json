{
  "name": "safetylink-core",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx server.ts",
    "build": "vite build && esbuild server.ts --bundle --platform=node --format=cjs --packages=external --sourcemap --outfile=dist/server.cjs",
    "cap:sync": "npx cap sync android",
    "branding": "node branding/generate-branding.cjs",
    "preview": "npm run build && node dist/server.cjs",
    "lint": "tsc --noEmit",
    "verify": "npm run lint && npm run build",
    "test": "tsx src/tests/run-tests.ts",
    "build:electron": "npm run build && electron-builder --win --publish never -c.extraMetadata.main=electron-main.cjs",
    "start": "node dist/server.cjs"
  },
  "dependencies": {
    "@capacitor-community/bluetooth-le": "^6.0.0",
    "@capacitor-mlkit/barcode-scanning": "^6.2.0",
    "@capacitor/android": "^6.0.0",
    "@capacitor/app": "^6.0.0",
    "@capacitor/core": "^6.0.0",
    "@capacitor/filesystem": "^6.0.4",
    "@capacitor/geolocation": "^6.0.0",
    "@capacitor/haptics": "^6.0.0",
    "@capacitor/local-notifications": "^6.0.0",
    "@capacitor/push-notifications": "^6.0.5",
    "@capacitor/share": "^6.0.4",
    "@capacitor/splash-screen": "^6.0.4",
    "@capawesome-team/capacitor-android-foreground-service": "^6.2.0",
    "@google/genai": "^2.16.0",
    "@libsql/client": "^0.17.4",
    "@supabase/supabase-js": "^2.111.0",
    "@types/d3": "^7.4.3",
    "@types/nodemailer": "^8.0.1",
    "@types/pg": "^8.20.3",
    "@vis.gl/react-google-maps": "^1.9.0",
    "bullmq": "^6.0.5",
    "cloudinary": "^2.10.1",
    "connectycube": "^6.3.0",
    "d3": "^7.9.0",
    "date-fns": "^4.4.0",
    "express": "^5.2.1",
    "express-rate-limit": "^8.6.2",
    "firebase": "^12.18.0",
    "firebase-admin": "^14.3.0",
    "helmet": "^8.3.0",
    "ioredis": "^6.0.0",
    "lucide-react": "^1.23.0",
    "motion": "^12.42.2",
    "nodemailer": "^9.0.5",
    "pg": "^8.22.0",
    "pusher": "^5.3.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-is": "^19.2.8",
    "react-onesignal": "^3.5.6",
    "react-router-dom": "^7.18.2",
    "recharts": "^3.10.1",
    "stytch": "^14.2.0",
    "twilio": "^6.0.2",
    "ws": "^8.21.3",
    "zustand": "^4.5.4"
  },
  "devDependencies": {
    "@capacitor/assets": "^3.0.5",
    "@capacitor/cli": "^8.4.2",
    "@types/express": "^5.0.6",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-react": "^6.0.5",
    "autoprefixer": "^10.5.4",
    "concurrently": "^10.0.5",
    "electron": "^43.4.1",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.28.2",
    "postcss": "^8.5.19",
    "sharp": "^0.35.3",
    "tailwindcss": "^3.4.19",
    "terser": "^5.50.0",
    "tsx": "^4.23.12",
    "typescript": "^5.9.3",
    "vite": "^8.2.0",
    "vite-plugin-pwa": "^1.2.0",
    "wait-on": "^9.1.0"
  },
  "main": "electron-main.cjs",
  "build": {
    "appId": "com.safetylink.console",
    "productName": "SafetyLink Response Console",
    "files": [
      "dist/**/*",
      "electron-main.cjs",
      "public/**/*"
    ],
    "directories": {
      "output": "electron-dist"
    },
    "win": {
      "icon": "public/sl-shield.svg",
      "target": [
        "nsis"
      ]
    }
  },
  "overrides": {
    "@capgo/capacitor-audio-recorder": {
      "@capacitor/core": "$@capacitor/core"
    }
  }
}
